{
  "version": "1.0",
  "profile": "selectivei",
  "inherit_from": "style_spec.common.v1.json",
  "experiment_types": ["selectivei"],
  "title_template": "SelectiveI Summary - {molecule_or_batch}",
  "constraints": {
    "include_detailed_results": false,
    "focus_scope": ["process", "final_conclusion"]
