{
  "version": "1.0",
  "profile": "mtt",
  "inherit_from": "style_spec.common.v1.json",
  "experiment_types": ["mtt"],
  "title_template": "MTT Experiment Summary - {molecule_or_batch}",
  "constraints": {
    "include_detailed_results": false,
    "focus_scope": ["process", "final_conclusion"]
  },
  "key_finding_fields": [
    "cell_viability_trend",
    "control_vs_treated_summary",
    "conclusion_statement"
  ],
  "preferred_terms": {
    "y_axis": "Cell Viability Rate",
    "x_axis": "Concentration"
  }
}
