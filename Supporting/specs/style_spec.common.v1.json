{
  "version": "1.0",
  "profile": "common",
  "description": "Common style for process + final conclusion reporting.",
  "constraints": {
    "include_detailed_results": false,
    "focus_scope": ["process", "final_conclusion"]
  },
  "section_order": [
    "experiment_context",
    "process_observation",
    "final_conclusion",
    "risk_and_notes"
  ],
  "language": {
    "default": "zh-CN",
    "tone": "formal_concise"
  },
  "formatting": {
    "number_precision": 4,
    "use_markdown_headings": true,
    "allow_markdown_tables": true
  },
  "required_outputs": {
    "must_include_key_findings": true,
    "must_include_conclusion": true
  }
}
