{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Strict JSON - Common v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "experiment_type",
    "style_profile",
    "title",
    "sections",
    "key_findings",
    "source_meta",
    "constraints"
  ],
  "properties": {
    "version": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "final"] },
    "experiment_type": { "type": "string" },
    "style_profile": { "type": "string" },
    "title": { "type": "string" },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_id", "heading", "paragraphs", "bullets"],
        "properties": {
          "section_id": {
            "type": "string",
            "enum": [
              "experiment_context",
              "process_observation",
              "final_conclusion",
              "risk_and_notes"
            ]
          },
          "heading": { "type": "string" },
          "paragraphs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "bullets": {
            "type": "array",
            "items": { "type": "string" }
          },
          "table_refs": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "key_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string" },
          "value": { "type": ["string", "number"] },
          "unit": { "type": "string" }
        }
      }
    },
    "source_meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_count"],
      "properties": {
        "source_count": { "type": "integer", "minimum": 0 },
        "source_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include_detailed_results"],
      "properties": {
        "include_detailed_results": {
          "type": "boolean",
          "enum": [false]
        }
      }
    }
  }
}
