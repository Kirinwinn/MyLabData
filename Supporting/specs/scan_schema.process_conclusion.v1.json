{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scan JSON - Process and Conclusion v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source_count", "records", "meta"],
  "properties": {
    "version": { "type": "string" },
    "source_count": { "type": "integer", "minimum": 0 },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_path",
          "capture_stage",
          "confidence",
          "process_summary",
          "conclusion_summary",
          "key_findings",
          "visual_elements"
        ],
        "properties": {
          "source_id": { "type": "string" },
          "source_path": { "type": "string" },
          "experiment_type": { "type": "string" },
          "capture_stage": {
            "type": "string",
            "enum": ["process", "final_conclusion", "unknown"]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "process_summary": {
            "type": "array",
            "items": { "type": "string" }
          },
          "conclusion_summary": {
            "type": "array",
            "items": { "type": "string" }
          },
          "key_findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "value"],
              "properties": {
                "label": { "type": "string" },
                "value": { "type": ["string", "number"] },
                "unit": { "type": "string" },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          },
          "visual_elements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["chart", "table", "image", "annotation", "unknown"]
                },
                "caption": { "type": "string" },
                "tags": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "tables": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "headers", "rows"],
              "properties": {
                "title": { "type": "string" },
                "headers": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "required": ["include_detailed_results"],
      "properties": {
        "include_detailed_results": {
          "type": "boolean",
          "enum": [false]
        }
      }
    }
  }
}
