# External DryData root. Do not store production data in the source repository.
MLD_DATA_ROOT=C:/path/to/DryData

# Fixed paths derived from MLD_DATA_ROOT:
#   DryData.duckdb, Jobs.duckdb, Incoming, Processed, Failed, Cache, Temp, New
# Optional production React bundle. When set, FastAPI serves this directory at
# the same origin as /api/v1 (for example: C:/MyLabData/frontend/dist).
# MLD_FRONTEND_DIST_DIRECTORY=C:/MyLabData/frontend/dist

# Application settings
MLD_HOST=127.0.0.1
MLD_PORT=8000
MLD_LOG_LEVEL=INFO

# DuckDB and Job worker settings
MLD_MEMORY_LIMIT=3GB
MLD_THREADS=4
MLD_QUERY_WORKERS=2
MLD_PRESERVE_INSERTION_ORDER=false
