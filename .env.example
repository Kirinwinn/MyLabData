# External DryData root. Do not store production data in the source repository.
MLD_DATA_ROOT=C:/path/to/DryData

# Optional path overrides. If omitted, paths are derived from MLD_DATA_ROOT.
# MLD_DATABASE_PATH=D:/MyLabData/DryData/Registry/mylabdata.duckdb
# MLD_TEMP_DIRECTORY=D:/MyLabData/DryData/Temp

# Application settings
MLD_HOST=127.0.0.1
MLD_PORT=8000
MLD_LOG_LEVEL=INFO

# DuckDB settings reserved for the database implementation phase
MLD_MEMORY_LIMIT=3GB
MLD_THREADS=4
MLD_PRESERVE_INSERTION_ORDER=false
